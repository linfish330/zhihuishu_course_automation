# 智慧树账号配置
ZHIHUISHU_USERNAME=YOURNAME
ZHIHUISHU_PASSWORD=YOURPASSWORD
COURSE_NAME="你要学习的课程名称"

# API配置（默认使用 DeepSeek OpenAI兼容 API，亦兼容 DASHSCOPE_API_KEY）
DEEPSEEK_API_KEY="你的API密钥"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# 答题模型配置
ENABLE_LLM_ANSWER=true   # 是否使用大模型自动答题（true/false）
ANSWER_MODEL="deepseek-v4-flash-vision-exp"  # 用于答题的模型

# 可选配置
ENABLE_REASONING=false    # 是否启用推理模式
